# ---------- Server ----------
PORT=8000
ENV=development

# ---------- Security ----------
# Must match AI_SERVICE_INTERNAL_KEY in the Node backend's .env — used both to
# verify inbound requests from Node and to authenticate outbound tool calls.
INTERNAL_SERVICE_KEY=replace_with_shared_secret_between_node_and_ai_service

# ---------- Node backend ----------
NODE_BACKEND_URL=http://localhost:5000

# ---------- LLM provider ----------
# "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Embeddings (for RAG) ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_API_KEY=

# ---------- RAG ----------
RAG_TOP_K=4
VECTOR_STORE_PATH=./data/vector_store.json
