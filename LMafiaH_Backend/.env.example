# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Your Vite + React frontend origin — must match exactly (scheme + host + port)
# for CORS and the refresh-token cookie to work.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
DATABASE_URL="postgresql://lmh_user:lmh_password@localhost:5432/luxury_mafia_hotel?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- JWT ----------
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Password reset ----------
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# ---------- Payments (Razorpay) ----------
# Leave blank in development to automatically fall back to the MockPaymentProvider
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Luxury Mafia Hotel <no-reply@luxurymafiahotel.com>"

# ---------- AI service ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=replace_with_shared_secret_between_node_and_ai_service

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# ---------- Tax / pricing ----------
TAX_RATE_PERCENT=12
SERVICE_CHARGE_PERCENT=5
